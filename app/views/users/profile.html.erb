<h1>Users#profile</h1>
<p>Find me in app/views/users/profile.html.erb</p>

<h1>プロフィール画面</h1>

<p><%= link_to "プロフィールを編集する", edit_user_path(@user) %></p>

<p>
  ユーザーアイコン:
  <% if @user.user_avatar.attached? %>
    <%= image_tag @user.user_avatar, size: '100x100' %>
  <% else %>
    <%= image_tag asset_path('default-user-avatar.png'), size: '100x100' %>
  <% end %>
</p>

<p>ユーザー名: <%= @user.user_name %></p>

<p>ユーザー紹介: <%= @user.user_introduction %></p>
