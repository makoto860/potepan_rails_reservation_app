<h1>プロフィール編集画面</h1>

<div class="users-edit-field" >
  <%= form_for @user do |f| %>
    <table class="new-table">
      <tr>
        <th><%= f.label :user_avatar, "ユーザーアイコン" %></th>
        <td><%= f.file_field :user_avatar %></td>
      </tr>

      <tr>
        <th><%= f.label :user_name, "ユーザー名" %></th>
        <td><%= f.text_field :user_name %></td>
      </tr>

      <tr>
        <th><%= f.label :user_introduction, "自己紹介" %></th>
        <td><%= f.text_area :user_introduction %></td>
      </tr>
    </table>

    <div>
      <ul>
        <li><%= link_to "キャンセル", :back %></li>
        <li><%= f.submit "保存" %></li>
      </ul>
    </div>
  <% end %>
</div>
