<h1>施設情報</h1>
<table>
  <tr>
    <th>施設名</th>
    <td><%= @room.room_name %></td>
  </tr>

  <tr>
    <th>施設イメージ</th>
    <td>
      <% if @room.room_avatar.attached? %>
        <%= image_tag @room.room_avatar, size: '100x100' %>
      <% else %>
        <%= image_tag asset_path('default-room-avatar.png'), size: '100x100' %>
      <% end %>
    </td>
  </tr>

  <tr>
    <th>施設詳細</th>
    <td><%= @room.room_detail %></td>
  </tr>

  <tr>
    <th>施設料金</th>
    <td><%= @room.fee %></td>
  </tr>

  <tr>
    <th>住所</th>
    <td><%= @room.address %></td>
  </tr>
</table>
<p><%= link_to "戻る", :back %></p>

<% if user_signed_in? %>
  <p>予約フォーム</p>
  <ul>
  <%= form_with model: @reservation, url: confirmation_reservations_path, method: :post, local: true, data: { turbo: false } do |f| %>
    <%= f.hidden_field :room_id, value: @room.id, name: 'reservation[room_id]' %>
    <%= f.hidden_field :user_id, value: current_user.id, name: 'reservation[user_id]' %>
    <li>合計人数<%= f.number_field :total_people, value: 1, name: 'reservation[total_people]' %></li>
    <li>チェックイン<%= f.date_field :check_in_date, name: 'reservation[check_in_date]' %></li>
    <li>チェックアウト<%= f.date_field :check_out_date, name: 'reservation[check_out_date]' %></li>
    <li><%= f.submit "確認画面へ" %></li>
  <% end %>
  </ul>
<% end %>
