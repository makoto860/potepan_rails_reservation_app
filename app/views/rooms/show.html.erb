<h1>施設情報</h1>
<table>
  <tr>
    <th>施設名</th>
    <td><%= @room.room_name %></td>
  </tr>

  <tr>
    <th>施設イメージ</th>
    <td></td>
  </tr>

  <tr>
    <th>施設詳細</th>
    <td><%= @room.room_detail %></td>
  </tr>

  <tr>
    <th>施設料金</th>
    <td><%= @room.fee %></td>
  </tr>

  <tr>
    <th>住所</th>
    <td><%= @room.address %></td>
  </tr>
</table>
<p><%= link_to "戻る", :back %></p>

<% if user_signed_in? %>
  <%= form_with model: @reservation, url: reservations_confirmation_path, method: :post do |f| %>
    <%= f.hidden_field :room_id, value: @room.id, name: 'reservation[room_id]' %>
    <%= f.hidden_field :user_id, value: current_user.id, name: 'reservation[user_id]' %>
    <%= f.number_field :total_people, value: 1, name: 'reservation[total_people]' %>
    <%= f.date_field :check_in_date, name: 'reservation[check_in_date]' %>
    <%= f.date_field :check_out_date, name: 'reservation[check_out_date]' %>
    <%= f.submit "確認画面へ" %>
  <% end %>
<% end %>
