<h1>施設の新規作成</h1>
<%= form_with model: @room do |f| %>
  <table>
    <tr>
      <th><%= f.label :room_name, "施設名" %></th>
      <td><%= f.text_field :room_name %></td>
    </tr>

    <tr>
      <th><%= f.label :room_avatar, "施設イメージ" %></th>
      <td><%= f.file_field :room_avatar %></td>
    </tr>

    <tr>
      <th><%= f.label :room_detail, "施設詳細" %></th>
      <td><%= f.text_area :room_detail %></td>
    </tr>

    <tr>
      <th><%= f.label :fee, "施設料金" %></th>
      <td><%= f.number_field :fee %></td>
    </tr>

    <tr>
      <th><%= f.label :address, "住所" %></th>
      <td><%= f.text_field :address %></td>
    </tr>
  </table>

  <div>
    <ul>
      <li><%= f.submit "施設を登録する"%></li>
    </ul>
  </div>
<% end %>
