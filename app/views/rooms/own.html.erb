<h1>ユーザーが登録した施設一覧</h1>

<%= form_with(url: search_rooms_path, local: true, method: :get, class: "keyword-search-form") do |form| %>
  <%= form.text_field :keyword, placeholder: "施設名、施設詳細", class: "keyword-search-input" %>
<%= form.submit "キーワード検索", class: "search-btn" %>
<% end %>

<div class="count">
  <p><%= @rooms.count %>件見つかりました</p>
</div>

<h1>施設一覧</h1>
<div class="room-own-field">
  <% @rooms.each do |room| %>
    <div class="room-field">
      <p><%=link_to room.room_name, room_path(room.id) %></p>
      <% if room.room_avatar.attached? %>
        <%= image_tag room.room_avatar %>
      <% else %>
        <%= image_tag asset_path('default-room-avatar.png') %>
      <% end %>
      <p><%= room.room_detail %></p>
      <p><%= room.fee %>円</p>
      <p><%= room.address %></p>
      <p><%= room.created_at.to_s(:date_jp) %></p>
      <p><%= link_to "施設編集", [:edit, room] %></p>
      <p><%= link_to "施設削除", room, method: :delete, data: { confirm: "施設を削除しますか？" } %></p>
    </div>
  <% end %>
<div>
