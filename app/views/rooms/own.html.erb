<h1>rooms/own.html.erb</h1>

<h1>ユーザーが登録した施設一覧</h1>

<%= form_with(url: search_rooms_path, local: true, method: :get, class: "search-form") do |form| %>
  <%= form.text_field :keyword, placeholder: "施設名、施設詳細", class: "search-input" %>
<%= form.submit "キーワード検索", class: "search-btn" %>
<% end %>

<div class="count">
  <p><%= @rooms.count %>件見つかりました</p>
</div>

<h1>施設一覧</h1>
  <table>
    <thead>
      <tr>
        <th>施設名</th>
        <th>施設イメージ</th>
        <th>施設詳細</th>
        <th>料金</th>
        <th>住所</th>
        <th>作成日</th>
        <th>編集</th>
        <th>削除</th>
      </tr>
    </thead>

    <% @rooms.each do |room| %>
      <tr>
        <td><%=link_to room.room_name, room_path(room.id) %></td>
        <td>
          <% if room.room_avatar.attached? %>
            <%= image_tag room.room_avatar, size: '100x100' %>
          <% else %>
            <%= image_tag asset_path('default-room-avatar.png'), size: '100x100' %>
          <% end %>
        </td>
        <td><%= room.room_detail %></td>
        <td><%= room.fee %>円</td>
        <td><%= room.address %></td>
        <td><%= room.created_at.to_s(:date_jp) %></td>
        <td><%= link_to "施設編集", [:edit, room] %></td>
        <td><%= link_to "施設削除", room, method: :delete, data: { confirm: "施設を削除しますか？" } %></td>
      </tr>
    <% end %>
  </table>
