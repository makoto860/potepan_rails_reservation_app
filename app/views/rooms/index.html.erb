<h1>Rooms#index</h1>
<p>Find me in app/views/rooms/index.html.erb</p>

<div class="count">
  <p><%= @rooms.count %>件見つかりました</p>
</div>

<h1>施設一覧</h1>
<table>
  <thead>
    <tr>
      <th>施設名</th>
      <th>施設イメージ</th>
      <th>施設詳細</th>
      <th>料金</th>
      <th>住所</th>
      <th>作成日</th>
      <th>編集</th>
      <th>削除</th>
    </tr>
  </thead>

  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td><%=link_to room.room_name, room_path(room.id) %></td>
        <td>
          <% if room.room_avatar.attached? %>
            <%= image_tag room.room_avatar, size: '100x100' %>
          <% else %>
            <%= image_tag asset_path('default-room-avatar.png'), size: '100x100' %>
          <% end %>
        </td>
        <td><%= room.room_detail %></td>
        <td><%= room.fee %></td>
        <td><%= room.address %></td>
        <td><%= room.created_at %></td>
        <td><%= link_to "施設編集", [:edit, room] %></td>
        <td><%= link_to "施設削除", room, method: :delete, data: { confirm: "施設を削除しますか？" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
