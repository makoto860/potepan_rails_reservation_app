<h1>Reservations#index</h1>
<p>Find me in app/views/reservations/index.html.erb</p>
<h1>予約内容の一覧</h1>

<% @reservations.each do |reservation| %>
  <table class="show-table">
    <tr>
      <th>施設イメージ</th>
      <td></td>
    </tr>

    <tr>
      <th>施設名</th>
      <td><%= reservation.room.room_name %></td>
    <tr>

    <tr>
      <th>施設詳細</th>
      <td></td>
    <tr>

    <tr>
      <th>合計料金</th>
      <td>円</td>
    <tr>

    <tr>
      <th>合計人数</th>
      <td><%= reservation.total_people %>人</td>
    <tr>

    <tr>
      <th>チェックイン日</th>
      <td><%= reservation.check_in_date.to_s(:date_jp) %></td>
    <tr>

    <tr>
      <th>チェックアウト日</th>
      <td><%= reservation.check_out_date.to_s(:date_jp) %></td>
    <tr>

    <tr>
      <th>予約確定日時</th>
      <td><%= reservation.created_at.to_s(:datetime_jp) %></td>
    <tr>

    </table>
    <p>------------------------------------------------------------------------------------------------------</p>
<% end %>
