<h1>札幌</h1>
<div class="count">
  <p><%= @rooms.count %>件が見つかりました</p>
</div>

<% @rooms.each do |room| %>
  <table class="show-table">
    <tr>
      <th>施設名</th>
      <td><%=link_to room.room_name, room_path(room.id) %></td>
    </tr>

    <tr>
      <th>施設詳細</th>
      <td><%= room.room_detail %></td>
    </tr>

    <tr>
      <th>施設料金</th>
      <td><%= room.fee %></td>
    </tr>

    <tr>
      <th>住所</th>
      <td><%= room.address %></td>
    </tr>

    <tr>
      <th>施設イメージ</th>
      <td>
        <% if room.room_avatar.attached? %>
          <%= image_tag room.room_avatar, size: '100x100' %>
        <% else %>
          <%= image_tag asset_path('default-room-avatar.png'), size: '100x100' %>
        <% end %>
      </td>
    </tr>
  </table>
<% end %>
