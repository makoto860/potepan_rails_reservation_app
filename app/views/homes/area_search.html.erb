<h1>エリア検索結果</h1>

<div class="count">
  <p><%= @rooms.count %>件見つかりました</p>
</div>

<br>

<div class="area-table">
  <% if current_user.present? %>
    <% @rooms.each do |room| %>
      <ul>
        <li>施設名: <%=link_to room.room_name, room_path(room.id) %></li>
        <li>施設詳細: <%= room.room_detail %></li>
        <li>料金: <%= room.fee %>円</li>
        <li>住所: <%= room.address %></li>
        <li>
          施設画像:
          <% if room.room_avatar.attached? %>
            <%= image_tag room.room_avatar, size: '100x100' %>
          <% else %>
            <%= image_tag asset_path('default-room-avatar.png'), size: '100x100' %>
          <% end %>
        </li>
      </ul>  
      <p>----------------------------</p>
    <% end %>

  <% else %>
    <% @rooms.each do |room| %>
      <ul>
        <li>施設名: <%= room.room_name %></li>
        <li>施設詳細: <%= room.room_detail %></li>
        <li>料金: <%= room.fee %>円</li>
        <li>住所: <%= room.address %></li>
        <li>
          施設画像:
          <% if room.room_avatar.attached? %>
            <%= image_tag room.room_avatar, size: '100x100' %>
          <% else %>
            <%= image_tag asset_path('default-room-avatar.png'), size: '100x100' %>
          <% end %>
        </li>
      </ul>
    <% end %>
  <% end %>
</div>
