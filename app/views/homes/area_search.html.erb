<h1>エリア検索結果</h1>

<div class="count">
  <p><%= @rooms.count %>件見つかりました</p>
</div>

<br>

<% @rooms.each do |room| %>
  <p>施設名: <%= room.room_name %></p>
  <p>施設詳細: <%= room.room_detail %></p>
  <p>料金: <%= room.fee %>円</p>
  <p>住所: <%= room.address %></p>
  <p>
    施設イメージ:
    <% if room.room_avatar.attached? %>
      <%= image_tag room.room_avatar, size: '100x100' %>
    <% else %>
      <%= image_tag asset_path('default-room-avatar.png'), size: '100x100' %>
    <% end %>
  </p>
  <p>----------------------------</p>
<% end %>
