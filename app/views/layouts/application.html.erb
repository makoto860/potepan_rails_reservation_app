<!DOCTYPE html>
<html>
  <head>
    <title>D</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header class="nav-bar">

      <div class="left-header">
        <p><%= link_to "Potepan Share", homes_top_path, class: "left-header_url" %></p>
      </div>

      <div class="right-header">
        <div class="header-icon">
          <% if current_user.present? %>
            <% if @user.user_avatar.attached? %>
              <p><%= image_tag @user.user_avatar, style: "border-radius: 50%; width: 70px; height: 70px; object-fit:cover;" %></p>
            <% else %>
              <p><%= image_tag asset_path('default-user-avatar.png'), style: "border-radius: 50%; width: 70px; height: 70px; object-fit:cover;" %></p>
            <% end %>

            <div class="nav-content">
              <div class="#" id="#">
                <a href="#" class="dropdown-toggle" id="#" role="#" data-toggle="dropdown" aria-haspopup="#" aria-expanded="#">
                  <p>ユーザー名: <%= current_user.user_name %></p>
                </a>

                <ul class="dropdown-menu" aria-labelledby="#" >
                  <li><%= link_to "施設の新規登録", new_room_path %></li>
                  <li><%= link_to "予約済み一覧", reservations_path %></li>
                  <li><%= link_to "ユーザーが登録した施設一覧", rooms_own_path %></li>
                  <li><%= link_to "ログアウト", destroy_user_session_path, method: :delete %></li>
                  <li><%= link_to "アカウント", users_account_path %></li>
                </ul>
              </div>
            </div>
          <% else %>
            <div class="right-nonlogin-header">
              <ul>
                <li><%= link_to "新規ログイン", new_user_registration_path %></li>
                <li><%= link_to "ログイン", new_user_session_path %></li>
              </ul>
            </div>
          <% end %>
          <br>
        </div>
      </div>
    </header>

    <h2 class="notice"><%= notice %></h2>
    <h2 class="alert"><%= alert %></h2>
    <%= yield %>
  </body>
</html>
