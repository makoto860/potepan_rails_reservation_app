<!DOCTYPE html>
<html>
  <head>
    <title>D</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header>
      <p class="notice"><%= notice %></p>
      <p class="alert"><%= alert %></p>

      <h1>アカウント情報（メールアドレス、パスワード）の編集ページを作成し、編集機能</h1>

      <p><%= link_to "TOP", homes_top_path %></p>
      <p><%= link_to "アカウント", users_account_path %></p>
      <p>フリーワード検索</p>

      <% if user_signed_in? %>
        <p>ユーザー名: <%= @user.user_name %></p>
        <p><%= link_to "ログアウト", :destroy_user_session, method: :delete, data: { confirm: "ログアウトしますか？" } %></p>    
        <p>ROOMリンク</p>
        <p>RESERVATIONリンク</p>
      <% else %>
        <p><%= link_to "新規ログイン", new_user_registration_path %></p>
        <p><%= link_to "ログイン", new_user_session_path %></p>
      <% end %>
    </header>
    <%= yield %>
  </body>
</html>
