<!DOCTYPE html>
<html>
  <head>
    <title>D</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header>
      <p class="notice"><%= notice %></p>
      <p class="alert"><%= alert %></p>

      <h1>エリアは、東京・大阪・京都・札幌の4つ</h1>

      <p><%= link_to "TOP", homes_top_path %></p>
      <p>フリーワード検索</p>
      
      <% if user_signed_in? %>
        <p>ユーザー名: <%= @user.user_name %></p>
        <p>
          <% if @user.user_avatar.attached? %>
            <%= image_tag @user.user_avatar, size: '100x100' %>
          <% else %>
            <%= image_tag asset_path('default-user-avatar.png'), size: '100x100' %>
          <% end %>
        </p>
        <p><%= link_to "ログアウト", destroy_user_session_path, method: :delete %></p>
        <p><%= link_to "アカウント", users_account_path %></p>
        <p><%= link_to "施設一覧", rooms_path %></p>
        <p>RESERVATIONリンク</p>
      <% else %>
        <p><%= link_to "新規ログイン", new_user_registration_path %></p>
        <p><%= link_to "ログイン", new_user_session_path %></p>
      <% end %>
    </header>
    <br>
    <%= yield %>
  </body>
</html>
